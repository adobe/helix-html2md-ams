{
  "name": "@adobe/helix-html2md-service",
  "version": "2.22.19",
  "private": true,
  "description": "Helix Html2MD Service",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "nodemon",
    "test": "c8 mocha -i -g 'Post-Deploy' --ignore=test/build-validation.test.js --spec test/*.test.js",
    "test-postdeploy": "mocha -g 'Post-Deploy' --spec test/*.test.js",
    "test:build": "npm run build && mocha --spec=test/build-validation.test.js",
    "lint": "eslint .",
    "semantic-release": "semantic-release",
    "build": "node build.js --test-bundle",
    "deploy": "node build.js --deploy --cleanup-patch=1y -l major",
    "deploy-test": "hedy -v --deploy --test --pkgVersion=test",
    "deploy-routes": "hedy --no-build --no-hints -l major",
    "deploy-ci": "hedy -v --deploy --test --pkgVersion=ci$CIRCLE_BUILD_NUM -l ci --cleanup-ci=24h",
    "postinstall": "patch-package"
  },
  "wsk": {
    "namespace": "helix",
    "target": "aws",
    "name": "helix3/html2md@${version}",
    "memory": "2048",
    "awsRole": "arn:${process.env.AWS_PARTITION}:iam::${process.env.AWS_ACCOUNT_ID}:role/${process.env.HLX_AWS_ROLE_NAME}",
    "awsRegion": "${process.env.AWS_REGION}",
    "awsAttachAuthorizer": "helix-token-authorizer_v2",
    "fastlyServiceId!important": "",
    "testUrl": "/_status_check/healthcheck.json",
    "nodeVersion": 22
  },
  "mocha": {
    "require": [
      "test/setup-env.js",
      "mocha-suppress-logs"
    ],
    "recursive": "true",
    "reporter": "mocha-multi-reporters",
    "reporter-options": "configFile=.mocha-multi.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/helix-html2md-service"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/adobe/helix-html2md-service/issues"
  },
  "homepage": "https://github.com/adobe/helix-html2md-service#readme",
  "dependencies": {
    "@adobe/fetch": "4.3.1",
    "@adobe/helix-html2md": "2.2.4",
    "@adobe/helix-mediahandler": "3.1.3",
    "@adobe/helix-shared-body-data": "2.2.7",
    "@adobe/helix-shared-string": "2.2.0",
    "@adobe/helix-shared-utils": "3.0.2",
    "@adobe/helix-shared-wrap": "2.0.2",
    "@adobe/helix-status": "10.1.5",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@adobe/eslint-config-helix": "3.0.32",
    "@adobe/helix-deploy": "14.4.7",
    "@adobe/helix-universal": "5.4.3",
    "@adobe/helix-universal-devserver": "1.1.150",
    "@aws-sdk/lib-storage": "3.1124.0",
    "@eslint/config-helpers": "0.7.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "c8": "12.0.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "junit-report-builder": "5.1.2",
    "lint-staged": "17.4.1",
    "mocha": "11.8.0",
    "mocha-multi-reporters": "1.5.1",
    "mocha-suppress-logs": "0.6.0",
    "nock": "14.0.17",
    "nodemon": "3.1.14",
    "patch-package": "^8.0.1",
    "semantic-release": "25.0.9"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "nodemonConfig": {
    "exec": "node --inspect ./test/dev/server.mjs",
    "watch": [
      ".env",
      "."
    ],
    "ext": ".js, .cjs, .ejs, .css"
  }
}
